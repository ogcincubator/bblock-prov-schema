{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "PROV Agent object schema",
  "$defs": {
    "Agent": {
      "$anchor": "Agent",
      "type": "object",
      "properties": {
        "provType": {
          "const": "Agent",
          "x-jsonld-id": "@type"
        },
        "type": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreObjectref",
          "x-jsonld-id": "type"
        },
        "name": {
          "type": "string",
          "x-jsonld-id": "http://www.w3.org/2000/01/rdf-schema#label"
        },
        "id": {
          "$ref": "bblocks://ogc.ogc-utils.prov#objectref",
          "x-jsonld-id": "@id"
        },
        "actedOnBehalfOf": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreAgentsOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#actedOnBehalfOf",
          "x-jsonld-type": "@id"
        },
        "atLocation": {
          "$ref": "bblocks://ogc.ogc-utils.prov#objectref",
          "x-jsonld-id": "http://www.w3.org/ns/prov#atLocation",
          "x-jsonld-type": "@id"
        },
        "qualifiedDelegation": {
          "oneOf": [
            {
              "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
            },
            {
              "$ref": "bblocks://ogc.ogc-utils.prov-activity#Delegation"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
                  },
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov-activity#Delegation"
                  }
                ]
              }
            }
          ],
          "x-jsonld-id": "http://www.w3.org/ns/prov#qualifiedDelegation",
          "x-jsonld-type": "@id"
        }
      },
      "required": [
        "id",
        "provType"
      ],
      "allOf": [
        {
          "$ref": "bblocks://ogc.ogc-utils.prov#influenced"
        }
      ]
    },
    "Association": {
      "$anchor": "Association",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "bblocks://ogc.ogc-utils.prov#objectref",
          "x-jsonld-id": "@id"
        },
        "provType": {
          "const": "Association",
          "x-jsonld-id": "@type"
        },
        "type": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreObjectref",
          "x-jsonld-id": "type"
        },
        "agent": {
          "oneOf": [
            {
              "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
            },
            {
              "$ref": "#/$defs/Agent"
            }
          ],
          "x-jsonld-id": "http://www.w3.org/ns/prov#agent",
          "x-jsonld-type": "@id"
        },
        "hadRole": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreObjectref",
          "x-jsonld-id": "http://www.w3.org/ns/prov#hadRole",
          "x-jsonld-type": "@id"
        },
        "hadPlan": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreObjectref",
          "x-jsonld-id": "http://www.w3.org/ns/prov#hadPlan",
          "x-jsonld-type": "@id"
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Agent"
    }
  ]
}
