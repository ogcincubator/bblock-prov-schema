{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "PROV Entity object schema",
  "$defs": {
    "Entity": {
      "$anchor": "Entity",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "bblocks://ogc.ogc-utils.prov#objectref",
          "x-jsonld-id": "@id"
        },
        "provType": {
          "const": "Entity",
          "x-jsonld-id": "@type"
        },
        "entityType": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreObjectref",
          "x-jsonld-id": "type"
        },
        "name": {
          "type": "string",
          "x-jsonld-id": "http://www.w3.org/2000/01/rdf-schema#label"
        },
        "hadMember": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreEntitiesOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#hadMember",
          "x-jsonld-type": "@id"
        },
        "wasGeneratedBy": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreActivitiesOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#wasGeneratedBy",
          "x-jsonld-type": "@id"
        },
        "wasAttributedTo": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreAgentsOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#wasAttributedTo",
          "x-jsonld-type": "@id"
        },
        "wasDerivedFrom": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreEntitiesOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#wasDerivedFrom",
          "x-jsonld-type": "@id"
        },
        "alternateOf": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreEntitiesOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#alternateOf",
          "x-jsonld-type": "@id"
        },
        "hadPrimarySource": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreEntitiesOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#hadPrimarySource",
          "x-jsonld-type": "@id"
        },
        "specializationOf": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreEntitiesOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#specializationOf",
          "x-jsonld-type": "@id"
        },
        "wasInvalidatedBy": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreActivitiesOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#wasInvalidatedBy",
          "x-jsonld-type": "@id"
        },
        "wasQuotedFrom": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreEntitiesOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#wasQuotedFrom",
          "x-jsonld-type": "@id"
        },
        "wasRevisionOf": {
          "$ref": "bblocks://ogc.ogc-utils.prov#oneOrMoreEntitiesOrRefIds",
          "x-jsonld-id": "http://www.w3.org/ns/prov#wasRevisionOf",
          "x-jsonld-type": "@id"
        },
        "atLocation": {
          "$ref": "bblocks://ogc.ogc-utils.prov#objectref",
          "x-jsonld-id": "http://www.w3.org/ns/prov#atLocation",
          "x-jsonld-type": "@id"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "bblocks://ogc.ogc-utils.prov#externalLink"
          },
          "x-jsonld-id": "http://www.w3.org/2000/01/rdf-schema#seeAlso"
        },
        "generatedAtTime": {
          "$ref": "bblocks://ogc.ogc-utils.prov-activity#dateTime",
          "x-jsonld-id": "http://www.w3.org/ns/prov#generatedAtTime",
          "x-jsonld-type": "http://www.w3.org/2001/XMLSchema#dateTime"
        },
        "invalidatedAtTime": {
          "$ref": "bblocks://ogc.ogc-utils.prov-activity#dateTime",
          "x-jsonld-id": "http://www.w3.org/ns/prov#invalidatedAtTime",
          "x-jsonld-type": "http://www.w3.org/2001/XMLSchema#dateTime"
        },
        "value": {
          "x-jsonld-id": "http://www.w3.org/ns/prov#value"
        },
        "qualifiedPrimarySource": {
          "oneOf": [
            {
              "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
            },
            {
              "$ref": "bblocks://ogc.ogc-utils.prov-activity#PrimarySource"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
                  },
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov-activity#PrimarySource"
                  }
                ]
              }
            }
          ],
          "x-jsonld-id": "http://www.w3.org/ns/prov#qualifiedPrimarySource",
          "x-jsonld-type": "@id"
        },
        "qualifiedQuotation": {
          "oneOf": [
            {
              "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
            },
            {
              "$ref": "bblocks://ogc.ogc-utils.prov-activity#Quotation"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
                  },
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov-activity#Quotation"
                  }
                ]
              }
            }
          ],
          "x-jsonld-id": "http://www.w3.org/ns/prov#qualifiedQuotation",
          "x-jsonld-type": "@id"
        },
        "qualifiedRevision": {
          "oneOf": [
            {
              "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
            },
            {
              "$ref": "bblocks://ogc.ogc-utils.prov-activity#Revision"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
                  },
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov-activity#Revision"
                  }
                ]
              }
            }
          ],
          "x-jsonld-id": "http://www.w3.org/ns/prov#qualifiedRevision",
          "x-jsonld-type": "@id"
        },
        "qualifiedGeneration": {
          "oneOf": [
            {
              "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
            },
            {
              "$ref": "bblocks://ogc.ogc-utils.prov-activity#Generation"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
                  },
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov-activity#Generation"
                  }
                ]
              }
            }
          ],
          "x-jsonld-id": "http://www.w3.org/ns/prov#qualifiedGeneration",
          "x-jsonld-type": "@id"
        },
        "qualifiedInvalidation": {
          "oneOf": [
            {
              "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
            },
            {
              "$ref": "bblocks://ogc.ogc-utils.prov-activity#Invalidation"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
                  },
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov-activity#Invalidation"
                  }
                ]
              }
            }
          ],
          "x-jsonld-id": "http://www.w3.org/ns/prov#qualifiedInvalidation",
          "x-jsonld-type": "@id"
        },
        "qualifiedDerivation": {
          "oneOf": [
            {
              "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
            },
            {
              "$ref": "bblocks://ogc.ogc-utils.prov-activity#Derivation"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
                  },
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov-activity#Derivation"
                  }
                ]
              }
            }
          ],
          "x-jsonld-id": "http://www.w3.org/ns/prov#qualifiedDerivation",
          "x-jsonld-type": "@id"
        },
        "qualifiedAttribution": {
          "oneOf": [
            {
              "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
            },
            {
              "$ref": "bblocks://ogc.ogc-utils.prov-activity#Attribution"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov#objectref"
                  },
                  {
                    "$ref": "bblocks://ogc.ogc-utils.prov-activity#Attribution"
                  }
                ]
              }
            }
          ],
          "x-jsonld-id": "http://www.w3.org/ns/prov#qualifiedAttribution",
          "x-jsonld-type": "@id"
        }
      },
      "required": [
        "id",
        "provType"
      ],
      "allOf": [
        {
          "$ref": "bblocks://ogc.ogc-utils.prov#influenced"
        },
        {
          "if": {
            "properties": {
              "entityType": {
                "anyOf": [
                  {
                    "const": "Collection"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "Collection"
                    }
                  }
                ]
              }
            },
            "required": [
              "entityType"
            ]
          },
          "then": {
            "required": [
              "hadMember"
            ],
            "properties": {
              "hadMember": {
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entityType": {
                "anyOf": [
                  {
                    "const": "EmptyCollection"
                  },
                  {
                    "type": "array",
                    "contains": {
                      "const": "EmptyCollection"
                    }
                  }
                ]
              }
            },
            "required": [
              "entityType"
            ]
          },
          "then": {
            "required": [
              "hadMember"
            ],
            "properties": {
              "hadMember": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Entity"
    }
  ]
}
